# ---------------------------------------------------------------------------
# Configuracion de ejemplo. Copia a .env y rellena. NUNCA subas .env al repo.
# ---------------------------------------------------------------------------

# Proveedor: mock | nvidia | openai | azure | anthropic
# "mock" ejecuta la demo completa SIN credenciales (por defecto).
LLM_PROVIDER=mock

# --- NVIDIA NIM (nivel gratuito; compatible con la API de OpenAI) ----------
# Obten la clave en https://build.nvidia.com
# LLM_PROVIDER=nvidia
# LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Alternativas verificadas: mistralai/mistral-large-2-instruct
#                           openai/gpt-oss-20b

# --- OpenAI ---------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Azure OpenAI ---------------------------------------------------------
# LLM_PROVIDER=azure
# LLM_API_KEY=<clave-del-recurso>
# LLM_BASE_URL=https://<tu-recurso>.openai.azure.com
# LLM_MODEL=<nombre-del-deployment>
# AZURE_API_VERSION=2024-10-21

# --- Anthropic ------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxx
# LLM_MODEL=claude-sonnet-4-5

# --- Parametros del agente ------------------------------------------------
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30
AGENT_MAX_ITERATIONS=6
AGENT_DEADLINE_S=90

# --- RAG ------------------------------------------------------------------
# hashing = local y determinista (sin red). nvidia = embeddings reales.
EMBEDDING_PROVIDER=hashing
RAG_TOP_K=4

# --- Simulacion de fallos (para demostrar manejo de errores) --------------
# 1.0 = el ERP falla siempre; util para grabar el caso de error.
ERP_FAIL_RATE=0.0
ERP_LATENCY_MS=0
